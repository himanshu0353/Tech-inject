# --- Supabase Database (PostgreSQL) ---
# Replace <your-project-ref> and <your-password> with your Supabase PostgreSQL credentials
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Cloud Storage & API Credentials ---
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (your secret service role key)
SUPABASE_STORAGE_BUCKET=component-bundles

# --- Auth & Security ---
JWT_SECRET=super_secret_production_jwt_key_change_me_2026
ADMIN_EMAIL=admin@techinject.com
ADMIN_PASSWORD=admin123
